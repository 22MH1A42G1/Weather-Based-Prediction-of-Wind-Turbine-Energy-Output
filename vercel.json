{
  "version": 2,
  "installCommand": "python -m pip install --break-system-packages -r requirements.txt",
  "builds": [
    {
      "src": "Project-Files/Flask-Wind-Mill-Power-Prediction/windApp.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "Project-Files/Flask-Wind-Mill-Power-Prediction/windApp.py"
    }
  ]
}
